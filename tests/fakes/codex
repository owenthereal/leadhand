#!/usr/bin/env python3
"""A fake `codex exec --json` for leadhand's tests. Never touches the network.

Logs one JSON line per run to $FAKE_CODEX_LOG: its argv, cwd, environment, the
`-c shell_environment_policy.set.<NAME>=<value>` overrides (decoded), the prompt
read from stdin, its pid and process group. Later lines in the same log record
the tool child it starts ("child") and how it ended ("exit").

Then it replays $FAKE_CODEX_SCENARIO, a JSON-lines file. A line with "type" is
an event printed to stdout; "{thread}" inside it is replaced by the thread ID
(the resumed one, else $FAKE_CODEX_THREAD, else a fixed ID). A line with
"action" does something:

  {"action": "sleep", "seconds": N}
  {"action": "stderr", "text": "..."}
  {"action": "last_message", "text": "..."}       writes the -o file
  {"action": "write_file", "path": "rel", "text": "..."}
  {"action": "commit", "message": "..."}          git add -A && git commit (if anything changed)
  {"action": "append_loop", "path": "rel", "interval": 0.2}   background writer
  {"action": "tool_child", "seconds": N}          a `sleep` child in its own group
  {"action": "escaped_writer", "path": "rel", "interval": 0.05}
        a double-forked writer in a new session (not a descendant of Codex once
        started), appending to `path` for up to 60 s; its pid is logged ("escaped")
  {"action": "rollout", "fixture": "name.jsonl"}  copies a fixture into
        $CODEX_HOME/sessions/2026/01/01/rollout-2026-01-01T00-00-00-<thread>.jsonl
        (skipped when $FAKE_CODEX_NO_ROLLOUT=1)
  {"action": "exit", "code": N}

Environment knobs: $FAKE_CODEX_DELAY (seconds to sleep before the scenario),
$FAKE_CODEX_IGNORE_SIGINT=1 (SIGINT does nothing), $FAKE_CODEX_ORPHAN_CHILD=1
(on SIGINT, exit without stopping the tool child; otherwise it is stopped first,
as the real Codex does).
"""
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import tomllib
from pathlib import Path

FIXTURES = Path(__file__).resolve().parents[1] / "fixtures"
DEFAULT_THREAD = "0f0f0f0f-0000-4000-8000-00000000c0de"
children: list[subprocess.Popen] = []


ESCAPED_WRITER = """
import os, sys, time
if os.fork():
    os._exit(0)
os.setsid()
path, interval = sys.argv[1], float(sys.argv[2])
with open(path, "a") as f:
    f.write("started\\n")
with open(path + ".tmp", "w") as f:
    f.write(str(os.getpid()))
os.replace(path + ".tmp", path + ".pid")
end = time.time() + 60
while time.time() < end:
    with open(path, "a") as f:
        f.write("x\\n")
    time.sleep(interval)
"""


def log(record: dict) -> None:
    path = os.environ.get("FAKE_CODEX_LOG")
    if path:
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps({"time": time.time(), "pid": os.getpid(), **record}) + "\n")


def parse(argv: list[str]) -> dict:
    out = {"policy_set": {}, "config": [], "add_dirs": [], "resume": None}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-m", "-C", "-s", "-o", "--add-dir", "-c") and i + 1 < len(argv):
            v = argv[i + 1]
            if a == "-c":
                out["config"].append(v)
                key, _, raw = v.partition("=")
                if key.startswith("shell_environment_policy.set."):
                    out["policy_set"][key.split(".", 2)[2]] = tomllib.loads(f"v = {raw}")["v"]
            elif a == "--add-dir":
                out["add_dirs"].append(v)
            else:
                out[a] = v
            i += 2
            continue
        if a == "resume" and i + 1 < len(argv):
            out["resume"] = argv[i + 1]
            i += 2
            continue
        i += 1
    return out


def stop_children() -> None:
    for c in children:
        if c.poll() is None:
            try:
                os.killpg(c.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass


def on_sigint(signum, frame) -> None:
    if os.environ.get("FAKE_CODEX_IGNORE_SIGINT") == "1":
        log({"event": "sigint_ignored"})
        return
    if os.environ.get("FAKE_CODEX_ORPHAN_CHILD") != "1":
        stop_children()
    log({"event": "exit", "how": "sigint"})
    os._exit(1)


def append_loop(path: Path, interval: float) -> None:
    n = 0
    while True:
        with open(path, "a", encoding="utf-8") as f:
            f.write(f"line {n}\n")
        n += 1
        time.sleep(interval)


def main() -> int:
    signal.signal(signal.SIGINT, on_sigint)
    argv = sys.argv[1:]
    opts = parse(argv)
    prompt = sys.stdin.read()
    log({"event": "start", "argv": argv, "cwd": os.getcwd(), "env": dict(os.environ),
         "policy_set": opts["policy_set"], "prompt": prompt, "pgid": os.getpgid(0)})
    if "-C" in opts:
        os.chdir(opts["-C"])
    thread = opts["resume"] or os.environ.get("FAKE_CODEX_THREAD") or DEFAULT_THREAD
    time.sleep(float(os.environ.get("FAKE_CODEX_DELAY") or 0))
    scenario = os.environ.get("FAKE_CODEX_SCENARIO")
    lines = Path(scenario).read_text(encoding="utf-8").splitlines() if scenario else []
    for line in lines:
        if not line.strip():
            continue
        step = json.loads(line.replace("{thread}", thread))
        action = step.get("action")
        if action is None:
            print(json.dumps(step), flush=True)
        elif action == "sleep":
            time.sleep(float(step["seconds"]))
        elif action == "stderr":
            print(step["text"], file=sys.stderr, flush=True)
        elif action == "last_message":
            if "-o" in opts:
                Path(opts["-o"]).write_text(step["text"], encoding="utf-8")
        elif action == "write_file":
            p = Path(step["path"])
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(step["text"], encoding="utf-8")
        elif action == "commit":
            git = ["git", "-c", "commit.gpgsign=false", "-c", "user.name=Fake Codex",
                   "-c", "user.email=fake@example.invalid"]
            subprocess.run([*git, "add", "-A"], check=True, timeout=30)
            if subprocess.run([*git, "diff", "--cached", "--quiet"], timeout=30).returncode:
                subprocess.run([*git, "commit", "--quiet", "-m", step["message"]], check=True, timeout=30)
        elif action == "append_loop":
            threading.Thread(target=append_loop, args=(Path(step["path"]), float(step["interval"])),
                             daemon=True).start()
        elif action == "tool_child":
            child = subprocess.Popen(["sleep", str(step["seconds"])], start_new_session=True,
                                     stdin=subprocess.DEVNULL)
            children.append(child)
            log({"event": "child", "child_pid": child.pid})
        elif action == "escaped_writer":
            target = Path(step["path"]).resolve()
            pidfile = target.with_name(target.name + ".pid")
            subprocess.run([sys.executable, "-c", ESCAPED_WRITER, str(target), str(step["interval"])],
                           stdin=subprocess.DEVNULL, timeout=30)
            deadline = time.monotonic() + 10
            while not pidfile.exists() and time.monotonic() < deadline:
                time.sleep(0.01)
            log({"event": "escaped", "escaped_pid": int(pidfile.read_text())})
        elif action == "rollout":
            home = os.environ.get("CODEX_HOME")
            if home and os.environ.get("FAKE_CODEX_NO_ROLLOUT") != "1":
                day = Path(home) / "sessions" / "2026" / "01" / "01"
                day.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(FIXTURES / step["fixture"],
                                day / f"rollout-2026-01-01T00-00-00-{thread}.jsonl")
        elif action == "exit":
            log({"event": "exit", "how": "scenario", "code": step["code"]})
            return int(step["code"])
        else:
            raise SystemExit(f"fake codex: unknown action {action!r}")
    log({"event": "exit", "how": "end", "code": 0})
    return 0


if __name__ == "__main__":
    sys.exit(main())
