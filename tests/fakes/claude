#!/usr/bin/env python3
"""A fake `claude` for leadhand's launcher tests. Never touches the network.

Appends one JSON line to $FAKE_CLAUDE_LOG when it starts: its argv, cwd, pid, ppid and
the LEADHAND_* environment variables the launcher sets (null when unset). Every line also
has "time", the wall-clock time it was written (time.time()). Then
it sleeps $FAKE_CLAUDE_SLEEP seconds (default 0) and exits $FAKE_CLAUDE_EXIT
(default 0).

With $FAKE_CLAUDE_SPAWN (a JSON argv list) it first starts that command as a child
that inherits every open descriptor (as Claude Code's Bash commands do), does not
wait for it, and appends {"pid": ..., "spawned": <child pid>}.

On SIGINT or SIGTERM it appends {"pid": ..., "signal": N} and exits 128 + N.
"""
import json
import os
import signal
import subprocess
import sys
import time

ENV_NAMES = ("LEADHAND_RUN_ID", "LEADHAND_RUN_DIR", "LEADHAND_CLI")


def log(record: dict) -> None:
    path = os.environ.get("FAKE_CLAUDE_LOG")
    if not path:
        return
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps({"time": time.time(), **record}) + "\n")
        f.flush()
        os.fsync(f.fileno())


def on_signal(signum, _frame) -> None:
    log({"pid": os.getpid(), "signal": signum})
    os._exit(128 + signum)


def main() -> int:
    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)
    log({"pid": os.getpid(), "ppid": os.getppid(), "argv": sys.argv, "cwd": os.getcwd(),
         "env": {name: os.environ.get(name) for name in ENV_NAMES}})
    spawn = os.environ.get("FAKE_CLAUDE_SPAWN")
    if spawn:
        child = subprocess.Popen(json.loads(spawn), close_fds=False, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        log({"pid": os.getpid(), "spawned": child.pid})
    deadline = time.monotonic() + float(os.environ.get("FAKE_CLAUDE_SLEEP", "0") or 0)
    while (left := deadline - time.monotonic()) > 0:
        time.sleep(min(left, 0.05))
    return int(os.environ.get("FAKE_CLAUDE_EXIT", "0") or 0)


if __name__ == "__main__":
    raise SystemExit(main())
